# =============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variable templates for the FOLKIFY frontend.
# Copy this file to .env and replace all placeholder values with actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# VITE_API_URL: Backend API URL
# For local development: http://localhost:3000
# For Railway production: https://folkify-api-production.up.railway.app
VITE_API_URL=https://folkify-api-production.up.railway.app

# -----------------------------------------------------------------------------
# Optional: Analytics Configuration
# -----------------------------------------------------------------------------
# VITE_ANALYTICS_ID: Analytics tracking ID (Google Analytics, Mixpanel, etc.)
# VITE_ANALYTICS_ID=<your-analytics-id>

# -----------------------------------------------------------------------------
# Optional: Feature Flags
# -----------------------------------------------------------------------------
# VITE_ENABLE_PREMIUM_FEATURES: Enable/disable premium features
# VITE_ENABLE_PREMIUM_FEATURES=true

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# Vercel Deployment:
#   1. Set VITE_API_URL to your Railway API domain
#   2. Add environment variables in Vercel dashboard
#   3. Deploy from GitHub main branch
#
# Local Development:
#   1. Copy this file to .env
#   2. Set VITE_API_URL=http://localhost:3000
#   3. Run: npm run dev
#
# Security Checklist:
#   ✓ Never commit .env file to Git
#   ✓ Use placeholders in .env.example, not real values
#   ✓ Verify VITE_API_URL matches your backend deployment
# =============================================================================
